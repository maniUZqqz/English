# Copy this file to `.env` and fill in real values.
AI_BASE_URL=https://api.metisai.ir/openai/v1
AI_API_KEY=your-api-key-here
AI_MODEL=gpt-4o-mini
# سقف تعداد درخواست AI هر کاربر در روز (پلن رایگان)
AI_DAILY_LIMIT=100
# درگاه پرداخت زرین‌پال — مرچنت کد ۳۶ کاراکتری از پنل زرین‌پال
ZARINPAL_MERCHANT_ID=
# True = درگاه آزمایشی سندباکس، False = درگاه واقعی
ZARINPAL_SANDBOX=True
# آدرس عمومی سایت (برای بازگشت از درگاه)
SITE_URL=http://127.0.0.1:8000
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
